# 喵站 · 仓库根 .gitignore
#
# ⚠️ 前两组是安全红线：本地密钥与运行数据绝不入库。
#    改这个文件前先想清楚 —— 一条泄漏就是真金白银的损失。

# ── 密钥与本地配置 ──
.env
.env.local
.env.hidden
开发版/后台管理系统/.env
开发版/后台管理系统/config.json
开发版/后台管理系统/config.local.json

# ── SQLite 数据库与上传文件（含用户数据、测试残留）──
开发版/后台管理系统/data/
开发版/后台管理系统/uploads/
*.db
*.db-wal
*.db-shm
*.sqlite
mail-outbox.log

# ── 内部资料：AI 工作记忆、回收站、发布打包产物 ──
.workbuddy/
.Trash-0/
dist/

# ── 杂项 ──
node_modules/
*.log
.DS_Store
Thumbs.db

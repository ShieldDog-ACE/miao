# 喵站 · 仓库根 .gitignore
#
# ⚠️ 第一组是安全红线：以后若再加任何密钥/本地配置，先进这里挡住。

# ── 密钥与本地配置（当前站点不需要，但别把这条规矩删了）──
.env
.env.local
.env.hidden
config.local.json

# ── 内部资料：AI 工作记忆、回收站、发布打包产物 ──
.workbuddy/
.Trash-0/
dist/

# ── 测试与工具依赖（不进产物）──
node_modules/
dev/tests/oracle/*.tmp
__pycache__/

# ── 杂项 ──
*.log
.DS_Store
Thumbs.db

# ── 日更 · 本地模型草稿（模型原始输出，不入库）──
dev/tools/daily/out/

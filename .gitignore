# 喵站 · 仓库根 .gitignore
#
# ⚠️ 前两组是安全红线：本地密钥与运行数据绝不入库。
#    改这个文件前先想清楚 —— 一条泄漏就是真金白银的损失。

# ── 密钥与本地配置 ──
.env
.env.local
.env.hidden
dev/backend/.env
dev/backend/config.json
dev/backend/config.local.json

# ── SQLite 数据库与上传文件（含用户数据、测试残留）──
dev/backend/data/
dev/backend/uploads/
*.db
*.db-wal
*.db-shm
*.sqlite
mail-outbox.log

# ── 大模型生成的中间产物与备份（含主管原稿抽取内容，不外传）──
dev/backend/phonemes.bak*/
dev/backend/tools/.pywork/

# ── 内部资料：AI 工作记忆、回收站、发布打包产物 ──
.workbuddy/
.Trash-0/
dist/

# ── 杂项 ──
node_modules/
*.log
.DS_Store
Thumbs.db

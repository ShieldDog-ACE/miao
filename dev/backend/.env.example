# 喵站后端 · 本地密钥文件模板
# 复制为 .env 并填入真实值。同目录 .gitignore 已忽略 .env，切勿提交。
# 只有本机 Node >= 22.5 的路径需要特殊指定时才用 MIAO_NODE_BIN
MIAO_NODE_BIN=/absolute/path/to/node
# 跑 tests/ 需要 jsdom；装在项目外时把它的 node_modules 指给 NODE_PATH
# NODE_PATH=/absolute/path/to/node_modules

# 登录验证码发信（不填则自动降级为「开发模式」：验证码打印到控制台并写入 data/mail-outbox.log）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@qq.com
SMTP_PASS=你的邮箱授权码
SMTP_FROM="喵站 <you@qq.com>"

# 后台管理系统（8788）登录口令：必须设置，否则每次启动随机生成一次性口令
MIAO_ADMIN_PASS=请改成你自己的强口令

# 8787 直接暴露公网时保持 false；仅在 Nginx/Caddy 反代之后才设 true
MIAO_TRUST_PROXY=false

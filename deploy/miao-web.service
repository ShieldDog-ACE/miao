# 喵站 · 前台与 API（8787）systemd 单元
#
# 安装：
#   sudo cp deploy/miao-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now miao-web
#   sudo systemctl status miao-web
#   journalctl -u miao-web -f          # 看日志
#
# 部署目录默认 /opt/miao，改的话下面三行路径一起改。

[Unit]
Description=喵站 · 前台与 API (8787)
Documentation=file:/opt/miao/dev/backend/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# 用你自己的账号（或专用的 miao 账号）跑：data/ 目录的读写权限跟着它走
User=miao
Group=miao

WorkingDirectory=/opt/miao/dev/backend

# 密钥（SMTP_PASS / MIAO_ADMIN_PASS）从这里读，不写进服务文件
EnvironmentFile=/opt/miao/dev/backend/.env

Environment=NODE_NO_WARNINGS=1
# 只监听本机，由 Nginx/Caddy 反代进来；挂在反代后记得在 .env 设 MIAO_TRUST_PROXY=true
Environment=MIAO_HOST=127.0.0.1

ExecStart=/usr/bin/env node index.js

Restart=always
RestartSec=3

# 加固：不给提权机会、独立 /tmp、系统目录只读
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

StandardOutput=journal
StandardError=journal
SyslogIdentifier=miao-web

[Install]
WantedBy=multi-user.target

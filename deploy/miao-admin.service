# 喵站 · 后台管理系统（8788）systemd 单元
#
# 安装：
#   sudo cp deploy/miao-admin.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now miao-admin
#   journalctl -u miao-admin -f
#
# ⚠️ 安全：8788 是管理员入口，别裸露在公网。
#    推荐 Nginx 子域 + Basic Auth 双保险（见 deploy/nginx.miao.conf），
#    或干脆只监听 127.0.0.1 然后用 SSH 隧道访问：
#       ssh -N -L 8788:127.0.0.1:8788 你的服务器
#    然后浏览器打开 http://127.0.0.1:8788/

[Unit]
Description=喵站 · 后台管理系统 (8788)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=miao
Group=miao
WorkingDirectory=/opt/miao/开发版/后台管理系统

# 后台口令 MIAO_ADMIN_PASS 从 .env 读；没配的话每次启动随机生成一次性口令
EnvironmentFile=/opt/miao/开发版/后台管理系统/.env

Environment=NODE_NO_WARNINGS=1
# 默认 127.0.0.1（配合反代/SSH 隧道）。要直接监听公网就改成 0.0.0.0 ——
# 但那意味着任何人只要能猜到口令就能进后台，务必先想清楚。
Environment=MIAO_ADMIN_HOST=127.0.0.1

ExecStart=/usr/bin/env node admin.js

Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

StandardOutput=journal
StandardError=journal
SyslogIdentifier=miao-admin

[Install]
WantedBy=multi-user.target
